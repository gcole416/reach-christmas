# This project uses two Supabase projects and relies on Next.js's built-in
# env file precedence to pick the right one automatically — no manual
# swapping needed:
#
#   .env.local              -> production project (fallback/default)
#   .env.development.local  -> dev/test project (wins during `npm run dev`)
#
# Neither file is committed (see .gitignore). Copy this file to whichever of
# the two you're setting up and fill in the values from that Supabase
# project's Settings > API page.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# (just the bare URL — no /rest/v1/ or other path suffix)
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key — safe to expose in client-side code.
# Security comes from Row Level Security policies (see supabase/migrations),
# not from keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT add the "secret" / "service_role" key here or anywhere in this app.
# It bypasses Row Level Security entirely and must never be shipped to the
# browser.
