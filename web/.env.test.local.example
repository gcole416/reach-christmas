# Credentials for the automated test suite (playwright.config.ts / tests/e2e).
# Copy this file to .env.test.local and fill in two DEV-project test accounts
# — never real staff accounts, never prod. Neither this file's real copy nor
# the credentials in it should ever be committed or pasted into chat.
#
# Setup (Supabase dashboard, DEV project → Authentication → Add user):
#   1. Create TEST_VOLUNTEER — check "Auto Confirm User" so it can sign in
#      immediately. No promotion needed; new accounts default to volunteer.
#   2. Create TEST_ADMIN the same way, then promote it to admin — either via
#      the app's Staff page (as another existing admin), or directly via SQL
#      (see supabase/migrations/20260708130000_profiles_staff_management.sql
#      for the promotion snippet).
#
# The suite tags everything it creates with sort_tag = 'AutoTest' and cleans
# it up after each run (see tests/e2e/helpers/cleanup.ts) — it never touches
# real families or your 'Demo'-tagged data, but it does exercise real writes
# against whichever drive is currently 'open' in the dev project, so make
# sure one exists before running tests.

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

TEST_VOLUNTEER_EMAIL=
TEST_VOLUNTEER_PASSWORD=
